<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🏫 Student Management System - Complete</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .header {
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: white;
            padding: 2rem;
            text-align: center;
        }
        .nav-tabs {
            display: flex;
            background: #f8f9fa;
            border-bottom: 2px solid #e9ecef;
        }
        .tab-btn {
            flex: 1;
            padding: 15px;
            background: none;
            border: none;
            cursor: pointer;
            font-size: 16px;
            font-weight: 500;
            transition: all 0.3s;
            border-bottom: 3px solid transparent;
        }
        .tab-btn:hover, .tab-btn.active {
            background: white;
            border-bottom-color: #667eea;
            color: #667eea;
        }
        .tab-content {
            display: none;
            padding: 2rem;
            min-height: 500px;
        }
        .tab-content.active {
            display: block;
        }
        .form-group {
            margin-bottom: 1.5rem;
        }
        label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: #333;
        }
        input, select, textarea {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e1e5e9;
            border-radius: 10px;
            font-size: 16px;
            transition: all 0.3s;
        }
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        .btn {
            width: 100%;
            padding: 15px;
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }
        .btn-success {
            background: linear-gradient(45deg, #28a745, #20c997);
        }
        .btn-danger {
            background: linear-gradient(45deg, #dc3545, #c82333);
        }
        .alert {
            padding: 15px;
            margin-bottom: 1.5rem;
            border-radius: 10px;
            font-weight: 500;
            text-align: center;
        }
        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .alert-error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        .alert-info {
            background: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }
        .student-card {
            background: #f8f9fa;
            padding: 1.5rem;
            margin-bottom: 1rem;
            border-radius: 15px;
            border-left: 5px solid #667eea;
            transition: all 0.3s;
        }
        .student-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        .stat-card {
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: white;
            padding: 1.5rem;
            border-radius: 15px;
            text-align: center;
        }
        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1rem;
        }
        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #dee2e6;
        }
        th {
            background: #667eea;
            color: white;
            font-weight: 600;
        }
        .hidden {
            display: none;
        }
        @media (max-width: 768px) {
            .nav-tabs {
                flex-direction: column;
            }
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>🏫 छात्र प्रबंधन प्रणाली</h1>
            <p>Complete Student Management System</p>
        </div>

        <!-- Navigation -->
        <div class="nav-tabs">
            <button class="tab-btn active" onclick="showTab('login')">🔐 लॉगिन</button>
            <button class="tab-btn" onclick="showTab('register')">📝 रजिस्ट्रेशन</button>
            <button class="tab-btn" onclick="showTab('admission')">🎓 एडमिशन</button>
            <button class="tab-btn" onclick="showTab('students')">👥 सभी छात्र</button>
            <button class="tab-btn" onclick="showTab('dashboard')">📊 डैशबोर्ड</button>
            <button class="tab-btn" onclick="showTab('reports')">📈 रिपोर्ट</button>
        </div>

        <!-- 1. Login Tab -->
        <div id="login" class="tab-content active">
            <h2>🔐 लॉगिन करें</h2>
            <div id="loginAlert"></div>
            <div class="form-group">
                <label>मोबाइल नंबर:</label>
                <input type="tel" id="loginMobile" placeholder="9876543210" maxlength="10">
            </div>
            <div class="form-group">
                <label>पासवर्ड:</label>
                <input type="password" id="loginPassword" placeholder="••••••••">
            </div>
            <button class="btn" onclick="loginUser()">लॉगिन करें</button>
        </div>

        <!-- 2. Registration Tab -->
        <div id="register" class="tab-content">
            <h2>📝 नया रजिस्ट्रेशन</h2>
            <div id="registerAlert"></div>
            <form id="regForm">
                <div class="form-group">
                    <label>पूर्ण नाम:</label>
                    <input type="text" id="regName" required>
                </div>
                <div class="form-group">
                    <label>मोबाइल नंबर:</label>
                    <input type="tel" id="regMobile" required maxlength="10">
                </div>
                <div class="form-group">
                    <label>ईमेल:</label>
                    <input type="email" id="regEmail">
                </div>
                <div class="form-group">
                    <label>पासवर्ड:</label>
                    <input type="password" id="regPassword" required minlength="6">
                </div>
                <button type="submit" class="btn">रजिस्टर करें</button>
            </form>
        </div>

        <!-- 3. Admission Tab -->
        <div id="admission" class="tab-content">
            <h2>🎓 नया एडमिशन</h2>
            <div id="admissionAlert"></div>
            <div class="form-group">
                <label>छात्र का नाम:</label>
                <input type="text" id="studentName" required>
            </div>
            <div class="form-group">
                <label>कक्षा:</label>
                <select id="studentClass" required>
                    <option value="">कक्षा चुनें</option>
                    <option value="1">कक्षा 1</option>
                    <option value="2">कक्षा 2</option>
                    <option value="3">कक्षा 3</option>
                    <option value="4">कक्षा 4</option>
                    <option value="5">कक्षा 5</option>
                    <option value="6">कक्षा 6</option>
                    <option value="7">कक्षा 7</option>
                    <option value="8">कक्षा 8</option>
                    <option value="9">कक्षा 9</option>
                    <option value="10">कक्षा 10</option>
                    <option value="11">कक्षा 11</option>
                    <option value="12">कक्षा 12</option>
                </select>
            </div>
            <div class="form-group">
                <label>माता का नाम:</label>
                <input type="text" id="motherName">
            </div>
            <div class="form-group">
                <label>पिता का नाम:</label>
                <input type="text" id="fatherName">
            </div>
            <div class="form-group">
                <label>मोबाइल नंबर:</label>
                <input type="tel" id="studentMobile" maxlength="10">
            </div>
            <div class="form-group">
                <label>पता:</label>
                <textarea id="studentAddress" rows="3" placeholder="पूरा पता लिखें..."></textarea>
            </div>
            <button class="btn btn-success" onclick="submitAdmission()">🎉 एडमिशन करें</button>
        </div>

        <!-- 4. Students Tab -->
        <div id="students" class="tab-content">
            <h2>👥 सभी छात्र</h2>
            <div id="studentsAlert"></div>
            <input type="text" id="searchStudent" placeholder="🔍 छात्र का नाम सर्च करें..." 
                   style="width: 100%; max-width: 400px; margin-bottom: 1rem; padding: 12px;">
            <div id="studentList" class="student-list"></div>
        </div>

        <!-- 5. Dashboard Tab -->
        <div id="dashboard" class="tab-content">
            <h2>📊 डैशबोर्ड - स्वागत है <span id="welcomeUser" style="color: #667eea;"></span>!</h2>
            <div id="dashboardAlert"></div>
            
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number" id="totalStudents">0</div>
                    <div>कुल छात्र</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="todayAdmissions">0</div>
                    <div>आज के एडमिशन</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="totalClasses">0</div>
                    <div>कुल कक्षाएँ</div>
                </div>
            </div>
            
            <button class="btn btn-danger" onclick="logout()" style="width: auto; padding: 12px 30px;">
                🚪 लॉगआउट
            </button>
        </div>

        <!-- 6. Reports Tab -->
        <div id="reports" class="tab-content">
            <h2>📈 रिपोर्ट्स</h2>
            <div id="reportsAlert"></div>
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-bottom: 2rem;">
                <div style="background: #f8f9fa; padding: 2rem; border-radius: 15px;">
                    <h3>📊 कक्षा-वार छात्र</h3>
                    <div id="classReport"></div>
                </div>
                <div style="background: #f8f9fa; padding: 2rem; border-radius: 15px;">
                    <h3>📅 मासिक एडमिशन</h3>
                    <div id="monthlyReport"></div>
                </div>
            </div>
            
            <table id="allStudentsTable">
                <thead>
                    <tr>
                        <th>नाम</th>
                        <th>कक्षा</th>
                        <th>माता-पिता</th>
                        <th>मोबाइल</th>
                        <th>एडमिशन तिथि</th>
                    </tr>
                </thead>
                <tbody id="reportTableBody"></tbody>
            </table>
        </div>
    </div>

    <script>
        // ==================== GLOBAL VARIABLES ====================
        let students = JSON.parse(localStorage.getItem('students')) || [];
        let currentUser = JSON.parse(localStorage.getItem('currentUser')) || null;
        let users = JSON.parse(localStorage.getItem('users')) || {};

        // ==================== INIT FUNCTION ====================
        function init() {
            if (currentUser) {
                document.getElementById('welcomeUser').textContent = currentUser.name;
                updateDashboardStats();
                showTab('dashboard');
            }
            showStudentList();
            updateReports();
        }

        // ==================== TAB NAVIGATION ====================
        function showTab(tabName) {
            if (!currentUser && (tabName === 'dashboard' || tabName === 'students' || tabName === 'reports')) {
                showAlert('loginAlert', '👆 सबसे पहले लॉगिन करें!', 'error');
                document.querySelector('.tab-btn[onclick="showTab(\'login\')"]').click();
                return;
            }

            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            
            // Show selected tab
            document.getElementById(tabName).classList.add('active');
            event.target.classList.add('active');
        }

        // ==================== ALERT SYSTEM ====================
        function showAlert(containerId, message, type = 'info') {
            const container = document.getElementById(containerId);
            container.innerHTML = `<div class="alert alert-${type}">${message}</div>`;
            setTimeout(() => container.innerHTML = '', 5000);
        }

        // ==================== 1. REGISTRATION ====================
        document.getElementById('regForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const name = document.getElementById('regName').value.trim();
            const mobile = document.getElementById('regMobile').value.trim();
            const email = document.getElementById('regEmail').value.trim();
            const password = document.getElementById('regPassword').value;

            // Validation
            if (mobile.length !== 10 || !/^\d+$/.test(mobile)) {
                showAlert('registerAlert', '❌ 10 अंकों का वैलिड मोबाइल नंबर डालें!', 'error');
                return;
            }
            if (password.length < 6) {
                showAlert('registerAlert', '❌ पासवर्ड कम से कम 6 अक्षर का हो!', 'error');
                return;
            }

            // Check duplicate
            if (users[mobile]) {
                showAlert('registerAlert', '❌ यह मोबाइल पहले से रजिस्टर्ड है!', 'error');
                return;
            }

            // Save user
            users[mobile] = { name, mobile, email, password, role: 'teacher' };
            localStorage.setItem('users', JSON.stringify(users));
            
            showAlert('registerAlert', '✅ रजिस्ट्रेशन सफल! अब लॉगिन करें।', 'success');
            this.reset();
        });

        // ==================== 2. LOGIN ====================
        function loginUser() {
            const mobile = document.getElementById('loginMobile').value.trim();
            const password = document.getElementById('loginPassword').value;

            if (!users[mobile]) {
                showAlert('loginAlert', '❌ मोबाइल नंबर रजिस्टर्ड नहीं है!', 'error');
                return;
            }

            const user = users[mobile];
            if (user.password !== password) {
                showAlert('loginAlert', '❌ गलत पासवर्ड!', 'error');
                return;
            }

            currentUser = user;
            localStorage.setItem('currentUser', JSON.stringify(currentUser));
            document.getElementById('welcomeUser').textContent = user.name;
            
            showAlert('dashboardAlert', `✅ स्वागत है ${user.name}! लॉगिन सफल।`, 'success');
            updateDashboardStats();
            showTab('dashboard');
        }

        // ==================== 3. ADMISSION ====================
        function submitAdmission() {
            const student = {
                id: Date.now(),
                name: document.getElementById('studentName').value.trim(),
                class: document.getElementById('studentClass').value,
                motherName: document.getElementById('motherName').value.trim(),
                fatherName: document.getElementById('fatherName').value.trim(),
                mobile: document.getElementById('studentMobile').value.trim(),
                address: document.getElementById('studentAddress').value.trim(),
                admissionDate: new Date().toISOString(),
                admittedBy: currentUser.name
            };

            // Validation
            if (!student.name || !student.class) {
                showAlert('admissionAlert', '❌ नाम और कक्षा भरें!', 'error');
                return;
            }

            students.unshift(student); // Add to beginning
            localStorage.setItem('students', JSON.stringify(students));
            
            showAlert('admissionAlert', `✅ ${student.name} का एडमिशन सफल! 🎉`, 'success');
            document.querySelector('#admission input, #admission select, #admission textarea').value = '';
            showStudentList();
            updateDashboardStats();
            updateReports();
        }

        // ==================== 4. STUDENTS LIST ====================
        function showStudentList(searchTerm = '') {
            const container = document.getElementById('studentList');
            const filteredStudents = students.filter(student => 
                student.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
                student.class.includes(searchTerm)
            );

            if (filteredStudents.length === 0) {
                container.innerHTML = '<div style="text-align: center; padding: 3rem; color: #666;">📭 कोई छात्र नहीं मिला</div>';
                return;
            }

            container.innerHTML = filteredStudents.map(student => `
                <div class="student-card">
                    <h3>👤 ${student.name}</h3>
                    <p><strong>🎓 कक्षा:</strong> ${student.class}</p>
                    <p><strong>👩 माता:</strong> ${student.motherName || 'N/A'}</p>
                    <p><strong>👨 पिता:</strong> ${student.fatherName || 'N/A'}</p>
                    <p><strong>📱 मोबाइल:</strong> ${student.mobile || 'N/A'}</p>
                    <p><strong>📍 पता:</strong> ${student.address || 'N/A'}</p>
                    <p><strong>📅 एडमिशन:</strong> ${new Date(student.admissionDate).toLocaleDateString('hi-IN')}</p>
                    <p><small><strong>👤 द्वारा:</strong> ${student.admittedBy}</small></p>
                </div>
            `).join('');
        }

        // Search functionality
        document.getElementById('searchStudent').addEventListener('input', function() {
            showStudentList(this.value);
        });

        // ==================== 5. DASHBOARD STATS ====================
        function updateDashboardStats() {
            const totalStudents = students.length;
            const today = new Date().toDateString();
            const todayAdmissions = students.filter(s => 
                new Date(s.admissionDate).toDateString() === today
            ).length;
            const classes = [...new Set(students.map(s => s.class))].length;

            document.getElementById('totalStudents').textContent = totalStudents;
            document.getElementById('todayAdmissions').textContent = todayAdmissions;
            document.getElementById('totalClasses').textContent = classes;
        }

        // ==================== 6. REPORTS ====================
        function updateReports() {
            // Class-wise report
            const classCount = {};
            students.forEach(student => {
                classCount[student.class] = (classCount[student.class] || 0) + 1;
            });
            
            document.getElementById('classReport').innerHTML = Object.entries(classCount)
                .map(([cls, count]) => `<div style="margin: 10px 0;"><strong>${cls}:</strong> ${count} छात्र</div>`)
                .join('') || '<p>कोई डेटा नहीं</p>';

            // Monthly report
            const monthly = {};
            students.forEach(student => {
                const month = new Date(student.admissionDate).toLocaleDateString('hi-IN', { month: 'short', year: 'numeric' });
                monthly[month] = (monthly[month] || 0) + 1;
            });
            
            document.getElementById('monthlyReport').innerHTML = Object.entries(monthly)
                .map(([month, count]) => `<div style="margin: 10px 0;"><strong>${month}:</strong> ${count} एडमिशन</div>`)
                .join('') || '<p>कोई डेटा नहीं</p>';

            // Table report
            const tbody = document.getElementById('reportTableBody');
            tbody.innerHTML = students.map(student => `
                <tr>
                    <td>${student.name}</td>
                    <td>${student.class}</td>
                    <td>${student.motherName || ''} / ${student.fatherName || ''}</td>
                    <td>${student.mobile || 'N/A'}</td>
                    <td>${new Date(student.admissionDate).toLocaleDateString('hi-IN')}</td>
                </tr>
            `).join('');
        }

        // ==================== LOGOUT ====================
        function logout() {
            currentUser = null;
            localStorage.removeItem('currentUser');
            showTab('login');
            showAlert('loginAlert', '👋 लॉगआउट सफल! दोबारा लॉगिन करें।', 'info');
        }

        // ==================== KEYBOARD SHORTCUTS ====================
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.key === 'Enter') {
                if (document.activeElement.closest('#admission')) submitAdmission();
                if (document.activeElement.closest('#login')) loginUser();
            }
        });

        // ==================== INITIALIZE ====================
        init();
    </script>
</body>
</html>
